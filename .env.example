# Copy to .env. Keep credentials out. OS environment takes precedence.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL_DEPLOYMENT_NAME=YOUR-DEPLOYMENT-NAME
# Optional advanced labs; leave unused settings empty.
FOUNDRY_SEARCH_ENDPOINT=
FOUNDRY_SEARCH_INDEX=
FOUNDRY_KNOWLEDGE_BASE=
FOUNDRY_EMBEDDING_DEPLOYMENT_NAME=
FOUNDRY_EMBEDDING_ENDPOINT=
FOUNDRY_JUDGE_DEPLOYMENT_NAME=
FOUNDRY_AUTH_MODE=cli
